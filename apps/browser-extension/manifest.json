{
  "manifest_version": 3,
  "name": "Context Layer",
  "version": "0.3.0",
  "description": "Sends focused page, text-selection/copy, and download provenance to the local Context Layer agent.",
  "permissions": [
    "alarms",
    "downloads",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start"
    }
  ]
}
