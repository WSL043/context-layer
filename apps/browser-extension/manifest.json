{
  "manifest_version": 3,
  "name": "Context Layer",
  "version": "0.1.0",
  "description": "Sends completed download provenance to the local Context Layer agent.",
  "permissions": [
    "alarms",
    "downloads",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
